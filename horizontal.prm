subsection Global parameters
    # finite element degrees for fluid and solid
    # Options: m_f = 2, m_s = 1, 2
    set fe_degree_fluid = 2
    set fe_degree_solid = 1
    # number of global refinements
    set n_refinements = 5
    # number of refinement cycles for convergence analysis
    # the reference solution is computed on 
    # refinement level n_refinements + n_refinement_cylces
    # at the start of the program
    set n_refinement_cycles = 0
    set do_spatial_analysis = false
    set do_temporal_analysis = false
    set output_skip = 1
    # sets the interface geometry
    # Options: sphere, horizontal
    set interface_type = horizontal
end

subsection Physical constants
    # Fluid parameters
    set inflow_velocity = 0.2
    set viscosity_fluid = 1.0e-3
    set density_fluid   = 1.0e+0

    # Solid parameters
    set density_solid   = 1.0e+0

    set mu      = 5.0e-3
    set lambda  = 1.0e-2
end

subsection Timestepping
    set end_time            = 10
    set timestep_size       = 1.0
end

subsection Ghost Parameters
    set ghost_parameter_velocity_fluid        = 1.0e-3
    set ghost_parameter_velocity_solid    = 1.0e-3
    set ghost_parameter_pressure              = 1.0e-3
    set ghost_parameter_displacement_velocity = 1.0e-3
    set max_ghost_weight                      = 1.0
    set nitsche_parameter                     = 1.0e+2
end
